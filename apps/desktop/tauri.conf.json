{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "qRNAmap",
  "version": "0.1.0",
  "identifier": "org.stajichlab.qrnamap",
  "build": {
    "beforeDevCommand": {
      "script": "bash scripts/build-site.sh",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "bash scripts/build-site.sh",
      "cwd": "../.."
    },
    "frontendDist": "../../dist-site"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  }
}
