{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "qRNAmap",
  "version": "0.1.0",
  "identifier": "org.stajichlab.qrnamap",
  "build": {
    "beforeDevCommand": "bash scripts/build-site.sh",
    "beforeBuildCommand": "bash scripts/build-site.sh",
    "frontendDist": "../../dist-site"
  },
  "app": {
    "windows": [
      {
        "title": "qRNAmap",
        "width": 1100,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  }
}
